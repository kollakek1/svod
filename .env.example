# Публичный адрес сайта. Нужен для canonical, OG и sitemap.
# Локально: http://localhost:3000. На проде: https://ваш-домен.ru
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Вход в админку. Пароль задаётся только здесь и хешируется при первом запуске.
ADMIN_EMAIL=owner@svod.clinic
ADMIN_PASSWORD=change-me-before-deploy

# Секрет для подписи сессионных cookie. Сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-32-byte-hex

# Postgres (Neon) для продакшена. Без него данные пишутся в .data/*.json.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
